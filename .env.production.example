# Production settings for the Next.js website. Copy to `.env.production` on the server.
# NEXT_PUBLIC_* values are baked in at build time: set them BEFORE `npm run build`.

# Live website address — used for canonical URLs, sitemap.xml, robots.txt, Open Graph and JSON-LD.
# Must be the final https URL without a trailing slash. www.<domain> is redirected here automatically.
NEXT_PUBLIC_BASE_URL=https://codigix.com

# Public URL of the backend API (admin panel, uploaded images).
NEXT_PUBLIC_API_URL=https://api.codigix.com

# Faster private address the website server uses to reach the API on the same machine.
API_INTERNAL_URL=http://127.0.0.1:5000

# Shared secret for instant cache refresh after admin edits — must match REVALIDATE_SECRET in backend/.env.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=

# Leave false on the live site. Set to true ONLY on a staging/test server so search engines never index it.
NEXT_PUBLIC_NOINDEX=false
