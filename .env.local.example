# Port where Next.js runs (e.g. 3002, 3005)
PORT=3002

# Public URL of this website (canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_BASE_URL=http://localhost:3002
# URL of the Node.js API in /backend (browser + server)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional: faster internal URL the Next server uses to reach the API (e.g. http://127.0.0.1:5000)
# API_INTERNAL_URL=
# Shared secret the backend uses to purge cached pages after admin edits (must match backend/.env)
REVALIDATE_SECRET=change-me-too
