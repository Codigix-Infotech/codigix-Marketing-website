# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (website + admin)
CORS_ORIGINS=http://localhost:3002
# Public URL of this API (used to build absolute media URLs)
API_PUBLIC_URL=http://localhost:5000

# ---- Database ----
# sqlite = built-in file database (no setup, stored in backend/data/). mysql = use the DB_* settings below.
DB_CLIENT=sqlite
SQLITE_FILE=data/codigix.db

# ---- MySQL (only when DB_CLIENT=mysql) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=codigix_cms

# ---- Auth ----
# Use a long random string in production: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# First admin user (created by `npm run seed` / `npm run create-admin`)
ADMIN_NAME=Codigix Admin
ADMIN_EMAIL=admin@codigix.com
ADMIN_PASSWORD=Admin@12345

# ---- Next.js on-demand revalidation ----
# The website URL and the shared secret (must match REVALIDATE_SECRET in the Next.js .env)
SITE_URL=http://localhost:3002
REVALIDATE_SECRET=change-me-too

# ---- Uploads ----
MAX_IMAGE_MB=8
MAX_RESUME_MB=5

# ---- Email (newsletter sending) ----
# Any SMTP provider works (Gmail app password, Brevo, Zoho, SES, your hosting mail...).
# Leave SMTP_HOST empty to disable sending; subscribers are still collected.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (SSL), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# e.g. Codigix Infotech <news@yourdomain.com>
MAIL_FROM=

# ---- Email deliverability (avoid the spam folder) ----
# 1. Send from a mailbox on YOUR domain (e.g. news@yourdomain.com), not gmail.com/yahoo.com.
# 2. Add the SPF, DKIM and DMARC DNS records your mail provider gives you.
# 3. Set API_PUBLIC_URL (above) to the public https address of this API so one-click unsubscribe works.
# Optional: where replies go, and the pause between recipients (milliseconds).
# MAIL_REPLY_TO=info@yourdomain.com
# MAIL_SEND_DELAY_MS=400

# Automatically email subscribers when a new blog post is published (set to false to turn off)
NEWSLETTER_AUTO_SEND=true
