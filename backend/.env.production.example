# Production settings for the backend API. Copy to `backend/.env` on the server.

NODE_ENV=production
PORT=5000

# Browsers allowed to call the API: the live website (both hosts, in case of redirects).
CORS_ORIGINS=https://codigix.com,https://www.codigix.com

# Public URL of this API — used to build absolute URLs for uploaded images.
API_PUBLIC_URL=https://api.codigix.com

# ---- Database ----
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=codigix_cms

# ---- Auth ----
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Website cache refresh after admin edits ----
# The website's address as reachable from this server, and the same secret as the website's .env.production.
SITE_URL=http://127.0.0.1:3000
REVALIDATE_SECRET=

# ---- Uploads ----
MAX_IMAGE_MB=8
MAX_RESUME_MB=5
